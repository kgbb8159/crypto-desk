# === LLM ===
# gemini | openai | anthropic | auto
LLM_PROVIDER=gemini

# Google Gemini (권장)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Pro 사용 시 예: gemini-2.5-pro

# (선택) 다른 LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# === Telegram ===
# 1) @BotFather 에서 봇 생성 → TELEGRAM_BOT_TOKEN
# 2) 봇과 대화 시작(또는 그룹에 추가)
# 3) chat id 확인:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    result[].message.chat.id 값을 TELEGRAM_CHAT_ID 에 넣기
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

# === News ===
# https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=

# === Macro (선택) ===
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# === 내 포트폴리오 평단가 ===
# 방법 A) 아래 .env 키
# 방법 B) config.json 사용 (config.example.json 참고)
# 통화: USD(기본) 또는 KRW — BTC처럼 원화 평단이면 BTC_CCY=KRW
# 거미줄: 가격:수량,가격:수량

USDKRW_RATE=
# 비우면 Yahoo USDKRW=X 자동 조회

BTC_AVG_PRICE=95000000
BTC_QTY=0.05
BTC_CCY=KRW
BTC_SPIDER_ORDERS=90000000:0.02,85000000:0.03

ETH_AVG_PRICE=
ETH_QTY=
ETH_CCY=USD
ETH_SPIDER_ORDERS=

SOL_AVG_PRICE=
SOL_QTY=
SOL_CCY=USD
SOL_SPIDER_ORDERS=

CRCL_AVG_PRICE=62.5
CRCL_QTY=100
CRCL_CCY=USD
CRCL_SPIDER_ORDERS=55:50,48:50

ONDO_AVG_PRICE=
ONDO_QTY=
ONDO_CCY=USD
ONDO_SPIDER_ORDERS=

LINK_AVG_PRICE=
LINK_QTY=
LINK_CCY=USD
LINK_SPIDER_ORDERS=

TAO_AVG_PRICE=320
TAO_QTY=5
TAO_CCY=USD
TAO_SPIDER_ORDERS=280:2,240:3

# === 동작 옵션 ===
# dry-run: LLM 없이 수집 데이터만 Markdown 초안 저장
DRY_RUN=false
REPORT_DIR=reports
